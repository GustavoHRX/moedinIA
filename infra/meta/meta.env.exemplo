# Copie para .env.meta NA RAIZ DO PROJETO (o git ignora esse nome) e preencha.
# Nunca cole esses valores no chat nem em arquivo versionado.

# Painel do app → WhatsApp → Configuração da API (API Setup)
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Token: nesta fase o TEMPORÁRIO (vale ~24 h). Depois vira o permanente do usuário do sistema.
META_ACCESS_TOKEN=
# Seu WhatsApp pessoal, só dígitos com DDI (ex.: 5519912345678) — o destinatário de teste
META_TEST_TO=
# Versão da Graph API usada nas chamadas
META_GRAPH_VERSION=v25.0
