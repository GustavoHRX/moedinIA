# =============================================================================
# Moedin-IA — modelo de variáveis de ambiente
# Copie para `.env` (raiz, usado pelo docker-compose: n8n, Evolution e ai-service) e para
# `apps/web/.env.local` (somente as NEXT_PUBLIC_* + as que o Next precisa).
# NUNCA versione `.env` nem `.env.local`. Só este arquivo vai pro git.
# =============================================================================

# --- PÚBLICAS (frontend-safe: vão para o bundle do navegador) -----------------
# Em produção, a URL canônica REAL (usada em canonical, Open Graph, sitemap, robots).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# E-mail de contato para assuntos de dados/privacidade (aparece no rodapé e nos termos).
NEXT_PUBLIC_CONTACT_EMAIL=
# URL do projeto Supabase e chave publicável/anon. São públicas por design:
# a proteção real é o RLS. Nunca coloque aqui a service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obs: o dashboard NÃO chama mais o ai-service direto do navegador
# (auditoria A-1). A chamada passa pela rota /api/insight do Next.

# --- BACKEND-ONLY (nunca com prefixo NEXT_PUBLIC_) ----------------------------
# SECRETA. Ignora RLS. Só backend/n8n. Se vazar, ROTACIONE no painel Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# SECRETA. Protege a rota /api/cron/recurrences (Vercel Cron gera o header
# Authorization: Bearer <CRON_SECRET> automaticamente). Gere: openssl rand -hex 32
CRON_SECRET=
# URL interna do serviço de IA (rede docker / servidor). Não deve ser pública.
AI_SERVICE_URL=http://localhost:8000
# SECRETA. Token compartilhado entre o ai-service, o site (/api/insight) e o n8n.
# Quando definida, o ai-service recusa (401) qualquer chamada sem o header
# `X-Service-Token` igual a ela. Vazia = serviço aberto (só aceitável local).
# OBRIGATÓRIA antes de expor o ai-service na internet. Gere: openssl rand -hex 32
AI_SERVICE_TOKEN=
# Restringe o CORS do ai-service. Lista separada por vírgula. Vazio = same-origin only.
AI_SERVICE_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limit (Upstash Redis, plano grátis) -------------------------------
# Protege as rotas /api/* de abuso — sobretudo /api/insight, que chama o
# ai-service e custa dinheiro por chamada. Cria um DB grátis em
# https://console.upstash.com (Redis) e copia o "REST API" URL + token.
# Se ficarem VAZIAS, o rate limit é DESLIGADO (dev funciona, mas produção fica
# exposta — configura antes de publicar).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- IA (secretas) -----------------------------------------------------------
# Groq (gratuito) interpreta TEXTO. Prioridade sobre a OpenAI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# OpenAI: imagem de comprovante, áudio e fallback de texto do ai-service.
# Se Groq e OpenAI ficarem vazios, o ai-service cai no parser por regex.
OPENAI_API_KEY=
# Modelo do AGENTE do WhatsApp (n8n lê em $env.OPENAI_MODEL). A chave do agente
# NÃO vem daqui: fica na credencial "OpenAi account" dentro do n8n.
OPENAI_MODEL=gpt-5.4-mini

# --- n8n / automação (secretas) --------------------------------------------
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
# SECRETA. 32+ chars. Se mudar depois de criar credenciais, elas ficam ilegíveis.
N8N_ENCRYPTION_KEY=change-me-32-chars-min
# AUDITORIA C-3: token exigido no header X-Webhook-Token dos webhooks do n8n.
# Gere com: openssl rand -hex 32   — e configure o mesmo valor no webhook da Evolution.
WHATSAPP_WEBHOOK_TOKEN=

# --- WhatsApp / Evolution API (secretas) -----------------------------------
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=moedin
# Token da instância na Evolution (opcional; só o empacotamento do bot usa).
EVOLUTION_INSTANCE_TOKEN=
# Numero do bot exibido no painel (botao "abrir conversa" e QR do onboarding).
# Mesmo numero pareado na Evolution, so digitos com DDI.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publica do painel, usada nas mensagens do bot (onboarding).
MOEDIN_APP_URL=
EVOLUTION_WA_VERSION=2.3000.1023204200

# --- Geral ----------------------------------------------------------------
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL

# Número (só dígitos, com DDI) que recebe o aviso do workflow de erros do bot.
# Vazio = o erro não é avisado a ninguém.
N8N_ALERT_WA_ID=

# No servidor do bot (infra/bot/docker-compose.yml) a URL do Supabase vai com
# este nome. No compose da raiz ela é copiada de NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
