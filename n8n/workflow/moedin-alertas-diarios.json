{
  "id": "MoedinAlertasDia1",
  "name": "Moedin.IA — Alertas diários (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
